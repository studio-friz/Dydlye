# Admin panel environment — copy this file to `.env` and fill in the values.
#
#   cp admin/.env.example admin/.env
#
# Values: Supabase Dashboard > Project Settings > API (URL) and
#         Supabase Dashboard > Project Settings > API Keys (publishable key).
#
# Do NOT put the service_role / secret key in this file. Every VITE_* value is
# compiled into the public JavaScript bundle, so a privileged key here would let
# anyone who loads the page read, edit and delete the whole database. The
# privileged work is done server-side by the `admin-api` Edge Function.

# https://<project-ref>.supabase.co
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Publishable key (sb_publishable_... or the legacy eyJ... anon token).
# Role must be "anon" or "authenticated" — never "service_role".
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-KEY"
