# Client app environment — copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# Values: Supabase Dashboard > Project Settings > API (URL) and
#         Supabase Dashboard > Project Settings > API Keys (publishable key).
#
# Only the two VITE_ variables are read by the app
# (src/integrations/supabase/client.ts and src/hooks/useHostSubscription.ts).
# The publishable key is designed to be public: every read and write is still
# filtered by the RLS policies in the database. Never put the service_role /
# secret key in this file.

# https://<project-ref>.supabase.co
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Publishable key (sb_publishable_... or the legacy eyJ... anon token).
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-KEY"

# ---------------------------------------------------------------------------
# Optional — only needed for Google sign-in on Android
# ---------------------------------------------------------------------------
# The Web client ID of your Google Cloud OAuth client. It is also written in
# capacitor.config.ts (plugins.GoogleAuth.androidClientId) and in
# src/routes/auth.tsx, so keep the three in sync. Leave it empty to run the app
# in the browser without Google sign-in.
# VITE_GOOGLE_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com"
